rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.admin == true;
    }
    function validKind(kind) {
      return kind in ['articles', 'churches', 'videos'];
    }
    match /content/{kind}/items/{itemId} {
      allow get, list: if validKind(kind) && (resource.data.published == true || isAdmin());
      allow create, update, delete: if validKind(kind) && isAdmin();
    }
  }
}
